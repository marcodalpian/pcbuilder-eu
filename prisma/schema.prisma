// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// --- Catalogo ---

enum ComponentCategory {
    CPU
    MOTHERBOARD
    MEMORY
    GPU
    STORAGE
    PSU
    CASE
    COOLER
}

model Component {
    id        String            @id @default(cuid())
    category  ComponentCategory
    brand     String
    model     String
    slug      String            @unique
    // Specifiche per categoria, validate con gli schemi zod in src/lib/engine/specs.ts
    specs     Json
    imageUrl  String?
    createdAt DateTime          @default(now())
    updatedAt DateTime          @updatedAt

    offers     Offer[]
    buildItems BuildItem[]

    @@unique([category, brand, model])
    @@index([category])
}

model Retailer {
    id           String  @id @default(cuid())
    name         String
    slug         String  @unique
    country      String // ISO 3166-1 alpha-2, es. "IT", "DE"
    baseUrl      String
    affiliateTag String?
    active       Boolean @default(true)

    offers Offer[]
}

// Un componente venduto da un retailer: prezzo attuale + storico.
model Offer {
    id            String   @id @default(cuid())
    componentId   String
    retailerId    String
    url           String
    priceCents    Int
    currency      String   @default("EUR")
    inStock       Boolean
    // EAN letto dalla pagina: serve a verificare che i link curati a mano
    // di negozi diversi puntino allo stesso prodotto.
    gtin          String?
    lastCheckedAt DateTime @default(now())
    // Ultima lettura fallita (pagina sparita, dati assenti...); null se ok.
    lastError     String?

    component Component    @relation(fields: [componentId], references: [id], onDelete: Cascade)
    retailer  Retailer     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
    history   PricePoint[]

    @@unique([componentId, retailerId])
    @@index([retailerId])
}

model PricePoint {
    id         String   @id @default(cuid())
    offerId    String
    priceCents Int
    inStock    Boolean
    recordedAt DateTime @default(now())

    offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

    @@index([offerId, recordedAt])
}

// --- Build utenti ---

model Build {
    id        String   @id @default(cuid())
    name      String
    // Id corto e non indovinabile per i link di condivisione
    shareId   String   @unique
    isPublic  Boolean  @default(false)
    userId    String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
    items BuildItem[]

    @@index([userId])
}

model BuildItem {
    id          String @id @default(cuid())
    buildId     String
    componentId String
    quantity    Int    @default(1)

    build     Build     @relation(fields: [buildId], references: [id], onDelete: Cascade)
    component Component @relation(fields: [componentId], references: [id], onDelete: Restrict)

    @@unique([buildId, componentId])
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    builds        Build[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
